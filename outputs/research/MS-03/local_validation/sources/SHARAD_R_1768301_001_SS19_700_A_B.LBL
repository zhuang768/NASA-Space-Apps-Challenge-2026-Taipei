INSTRUMENT_ID                      = SHARAD
INSTRUMENT_NAME                    = "SHALLOW RADAR"
TARGET_NAME                        = MARS
ORBIT_NUMBER                       = 17683
MRO:START_SUB_SPACECRAFT_LONGITUDE = 249.544036  <DEG> 
MRO:START_SUB_SPACECRAFT_LATITUDE  = 74.927799  <DEG> 
MRO:STOP_SUB_SPACECRAFT_LONGITUDE  = 237.478500  <DEG> 
