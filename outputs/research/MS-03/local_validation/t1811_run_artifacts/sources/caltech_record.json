ersonal", "name": "Romeo, Giuseppe", "given_name": "Giuseppe", "family_name": "Romeo"}, "affiliations": [{"id": "029pp9z10", "name": "Johns Hopkins University Applied Physics Laboratory", "identifiers": [{"identifier": "029pp9z10", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Santo, Andrew G.", "given_name": "Andrew G.", "family_name": "Santo"}, "affiliations": [{"id": "029pp9z10", "name": "Johns Hopkins University Applied Physics Laboratory", "identifiers": [{"identifier": "029pp9z10", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Smith, Michael D.", "given_name": "Michael D.", "family_name": "Smith"}, "affiliations": [{"id": "0171mag52", "name": "Goddard Space Flight Center", "identifiers": [{"identifier": "0171mag52", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Stephens, David C.", "given_name": "David C.", "family_name": "Stephens"}, "affiliations": [{"id": "029pp9z10", "name": "Johns Hopkins University Applied Physics Laboratory", "identifiers": [{"identifier": "029pp9z10", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Toigo, Anthony D.", "given_name": "Anthony D.", "family_name": "Toigo"}, "affiliations": [{"id": "029pp9z10", "name": "Johns Hopkins University Applied Physics Laboratory", "identifiers": [{"identifier": "029pp9z10", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Viviano, Christina E.", "given_name": "Christina E.", "family_name": "Viviano", "identifiers": [{"identifier": "0000-0003-1601-2105", "scheme": "orcid"}]}, "affiliations": [{"id": "029pp9z10", "name": "Johns Hopkins University Applied Physics Laboratory", "identifiers": [{"identifier": "029pp9z10", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Wolff, Michael J.", "given_name": "Michael J.", "family_name": "Wolff"}, "affiliations": [{"id": "046a9q865", "name": "Space Science Institute", "identifiers": [{"identifier": "046a9q865", "scheme": "ror"}]}]}], "title": "The CRISM investigation in Mars orbit: Overview, history, and delivered data products", "publisher": "Elsevier", "publication_date": "2024-09-01", "subjects": [{"subject": "Mars, atmosphere"}, {"subject": "Mars, surface"}, {"subject": "Mineralogy"}, {"subject": "Instrumentation"}], "dates": [{"date": "2023-05-02", "type": {"id": "accepted", "title": {"de": "Angenommen", "en": "Accepted"}}}, {"date": "2023-05-03", "type": {"id": "available", "title": {"de": "Verf\u00fcgbar", "en": "Available"}}, "description": "Available online"}, {"date": "2024-07-17", "type": {"id": "available", "title": {"de": "Verf\u00fcgbar", "en": "Available"}}, "description": "Version of record"}], "languages": [{"id": "eng", "title": {"en": "English"}}], "version": "Published", "rights": [{"id": "cc-by-nc-nd-4.0", "title": {"en": "Creative Commons Attribution Non Commercial No Derivatives 4.0 International"}, "description": {"en": ""}, "props": {"url": "https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode", "scheme": "spdx"}}], "description": "The Compact Reconnaissance Imaging Spectrometer for Mars (CRISM) on the Mars Reconnaissance Orbiter (MRO) collected hyperspectral images of the Martian surface and atmosphere from September 27, 2006, through May 7, 2022. Over that time, nearly twenty scientific investigations were completed, most of which arose as a result of the findings from previous investigations. Two review papers published in 2009 (Murchie et al., 2009a, b) described the initial two-year investigation during MRO's Primary Science Phase, its key findings, and the CRISM data products that were developed and released to the community through that time. Here we describe the conduct and evolution of the CRISM investigation since then, which includes MRO's Extended Science Phase and first five Extended Missions. We document the physical changes in the instrument as it aged, including capabilities that were lost as well as new modes of operation not initially envisioned; the new science questions that were investigated and their key findings; anatomy of the extensive collection of data products that have been released to the Planetary Data System; the \"final\" radiometric calibration; high-order derived products produced from high-resolution targeted observations and global mapping campaigns; and data processing and analysis tools which have been developed and released by the CRISM team.", "additional_descriptions": [{"description": "<p>&copy; 2023 The Authors. Published by Elsevier Inc. This is an open access article under the CC BY-NC-ND license (<a href=\"http://creativecommons.org/licenses/by-nc-nd/4.0/\">http://creativecommons.org/licenses/by-nc-nd/4.0/</a>)</p>", "type": {"id": "copyright", "title": {"de": "Sonstige", "en": "Copyright and License"}}}, {"description": "<p class=\"MsoNormal\">This work was funded by Jet Propulsion Laboratory subcontract 1277793 to the Johns Hopkins University Applied Physics Laboratory for conduct of the CRISM Investigation, and NASA Planetary Data Archiving, Restoration, and Tools (PDART) grant 80NSSC19K0418. The CRISM team gratefully acknowledges support from the MRO Project and the PDS Geosciences Node.</p>", "type": {"id": "acknowledgement", "title": {"de": "Sonstige", "en": "Acknowledgement"}}}, {"description": "<p>Data shared in thee PDS.</p>", "type": {"id": "data-availability", "title": {"de": "Sonstige", "en": "Data Availability"}}}], "funding": [{"funder": {"id": "027k65916", "name": "Jet Propulsion Laboratory"}, "award": {"number": "1277793", "title": {"en": " "}}}, {"funder": {"id": "029pp9z10", "name": "Johns Hopkins University Applied Physics Laboratory"}}, {"funder": {"id": "027ka1x80", "name": "National Aeronautics and Space Administration"}, "award": {"number": "80NSSC19K0418", "title": {"en": " "}}}]}, "custom_fields": {"journal:journal": {"title": "Icarus", "volume": "419", "pages": "115612", "issn": "0019-1035"}, "caltech:groups": [{"id": "Division-of-Geological-and-Planetary-Sciences", "title": {"en": "Division of Geological and Planetary Sciences (GPS)"}}], "caltech:publication_status": [{"id": "published", "title": {"en": "Published"}}]}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "default_preview": "1-s2.0-S0019103523001896-main.pdf", "order": [], "count": 1, "total_bytes": 30640863, "entries": {"1-s2.0-S0019103523001896-main.pdf": {"id": "eb7ed0a2-1aff-411f-aca3-5d7c0f1c168b", "checksum": "md5:087160d4b88a9eeb1f827526bc5f8e79", "ext": "pdf", "size": 30640863, "mimetype": "application/pdf", "storage_class": "L", "key": "1-s2.0-S0019103523001896-main.pdf", "metadata": null, "access": {"hidden": false}, "links": {"self": "https://authors.library.caltech.edu/api/records/h6pv6-fhf02/files/1-s2.0-S0019103523001896-main.pdf", "content": "https://authors.library.caltech.edu/api/records/h6pv6-fhf02/files/1-s2.0-S0019103523001896-main.pdf/content", "iiif_canvas": "https://authors.library.caltech.edu/api/iiif/record:h6pv6-fhf02/canvas/1-s2.0-S0019103523001896-main.pdf", "iiif_base": "https://authors.library.caltech.edu/api/iiif/record:h6pv6-fhf02:1-s2.0-S0019103523001896-main.pdf", "iiif_info": "https://authors.library.caltech.edu/api/iiif/record:h6pv6-fhf02:1-s2.0-S0019103523001896-main.pdf/info.json", "iiif_api": "https://authors.library.caltech.edu/api/iiif/record:h6pv6-fhf02:1-s2.0-S0019103523001896-main.pdf/full/full/0/default.png"}}}}, "media_files": {"enabled": false, "order": [], "count": 0, "total_bytes": 0, "entries": {}}, "status": "published", "deletion_status": {"is_deleted": false, "status": "P"}, "stats": {"this_version": {"views": 172, "unique_views": 151, "downloads": 89, "unique_downloads": 88, "data_volume": 2727036807.0}, "all_versions": {"views": 172, "unique_views": 151, "downloads": 89, "unique_downloads": 88, "data_volume": 2727036807.0}}}