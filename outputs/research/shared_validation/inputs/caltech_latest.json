628", "access": {"owned_by": {"user": "215"}}, "communities": {}, "pids": {}}, "versions": {"is_latest": true, "index": 1}, "is_published": true, "is_draft": false, "pids": {"doi": {"identifier": "10.22002/D1.1316", "provider": "datacite", "client": "datacite"}, "oai": {"identifier": "oai:data.caltech.edu:ym7fc-x0r93", "provider": "oai"}}, "metadata": {"resource_type": {"id": "dataset", "title": {"en": "Dataset"}}, "creators": [{"person_or_org": {"type": "personal", "name": "Piqueux, Sylvain", "given_name": "Sylvain", "family_name": "Piqueux", "identifiers": [{"identifier": "0000-0003-0485-2908", "scheme": "orcid"}]}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}, {"id": "027k65916", "name": "Jet Propulsion Lab", "identifiers": [{"identifier": "027k65916", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Buz, Jennifer", "given_name": "Jennifer", "family_name": "Buz"}, "affiliations": [{"name": "Department of Physics and Astronomy, Northern Arizona University"}]}, {"person_or_org": {"type": "personal", "name": "Edwards, Christopher S.", "given_name": "Christopher S.", "family_name": "Edwards"}, "affiliations": [{"name": "Department of Physics and Astronomy, Northern Arizona University"}]}, {"person_or_org": {"type": "personal", "name": "Bandfield, Joshua L.", "given_name": "Joshua L.", "family_name": "Bandfield"}, "affiliations": [{"id": "046a9q865", "name": "Space Science Institute", "identifiers": [{"identifier": "046a9q865", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Kleinb\u00f6hl, Armin", "given_name": "Armin", "family_name": "Kleinb\u00f6hl"}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}, {"id": "027k65916", "name": "Jet Propulsion Lab", "identifiers": [{"identifier": "027k65916", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Kass, David M.", "given_name": "David M.", "family_name": "Kass"}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}, {"id": "027k65916", "name": "Jet Propulsion Lab", "identifiers": [{"identifier": "027k65916", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Hayne, Paul O.", "given_name": "Paul O.", "family_name": "Hayne"}, "affiliations": [{"id": "02ttsq026", "name": "University of Colorado Boulder", "identifiers": [{"identifier": "02ttsq026", "scheme": "ror"}]}, {"id": "01fcjzv38", "name": "Laboratory for Atmospheric and Space Physics", "identifiers": [{"identifier": "01fcjzv38", "scheme": "ror"}]}]}], "title": "Widespread Shallow Water Ice on Mars at High and Mid Latitudes", "publisher": "CaltechDATA", "publication_date": "2019-11-27", "subjects": [{"subject": "ice"}, {"subject": "mars"}, {"subject": "water ice"}], "languages": [{"id": "eng", "title": {"en": "English"}}], "identifiers": [{"identifier": "1316", "scheme": "cdid"}], "version": "1.0", "rights": [{"title": {"en": "cc-zero"}}], "description": "The auxiliary information associated with \"Widespread Shallow Water Ice on Mars at High and Mid Latitudes\" \nby Piqueux et al. consists of a set of 2 maps (d_m.ascii and TI_SI.ascii) and 2 coordinate files (Lon.ascii and Lat.ascii).\n- d_m.ascii (720 x 360): Depth to the top of the water ice table, in meter\n- TI_SI.ascii (720 x 360): Upper (dry) regolith thermal inertia, in J m^2 K-1 s^-1/2\nThese maps are projected on a simple cylindrical canevas; the coordinates can be using these two files:\n- Lon.ascii (720 x 1)\n- Lat.ascii (1 x 360)\n\nResolution is 2ppd. Empty bin are assigned -32768.\n\nThese files were created from work performed at the Jet Propulsion Laboratory, California Institute of Technology, under a contract with NASA.\nGovernment Support Acknowledged."}, "custom_fields": {}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 5, "total_bytes": 4928149, "entries": {"Lat.ascii": {"id": "981a014d-9c08-4f58-8d36-1b280bf4f2ba", "checksum": "md5:9b70d4b2f0297594ce7e02494cf8564b", "ext": "ascii", "size": 2660, "mimetype": "text/vnd.ascii-art", "storage_class": "L", "key": "Lat.ascii", "metadata": null, "access": {"hidden": false}, "links": {"self": "https://data.caltech.edu/api/records/ym7fc-x0r93/files/Lat.ascii", "content": "https://data.caltech.edu/api/records/ym7fc-x0r93/files/Lat.ascii/content"}}, "Lon.ascii": {"id": "25188ddd-c741-4014-b645-6e06067d0355", "checksum": "md5:c60b8ff5f8b0bc603c92967862ad7431", "ext": "ascii", "size": 4820, "mimetype": "text/vnd.ascii-art", "storage_class": "L", "key": "Lon.ascii", "metadata": null, "access": {"hidden": false}, "links": {"self": "https://data.caltech.edu/api/records/ym7fc-x0r93/files/Lon.ascii", "content": "https://data.caltech.edu/api/records/ym7fc-x0r93/files/Lon.ascii/content"}}, "Notes.txt": {"id": "d4fb1f25-0a51-44e8-8184-137e1ee02278", "checksum": "md5:931c03a665d02755470be11becf7841b", "ext": "txt", "size": 1926, "mimetype": "text/plain", "storage_class": "L", "key": "Notes.txt", "metadata": null, "access": {"hidden": false}, "links": {"self": "https://data.caltech.edu/api/records/ym7fc-x0r93/files/Notes.txt", "content": "https://data.caltech.edu/api/records/ym7fc-x0r93/files/Notes.txt/content"}}, "TI_SI.ascii": {"id": "54d55347-3848-4dae-816b-33073d42f131", "checksum": "md5:267810eb52f6c053dd2adefe4dc2010a", "ext": "ascii", "size": 2484261, "mimetype": "text/vnd.ascii-art", "storage_class": "L", "key": "TI_SI.ascii", "metadata": null, "access": {"hidden": false}, "links": {"self": "https://data.caltech.edu/api/records/ym7fc-x0r93/files/TI_SI.ascii", "content": "https://data.caltech.edu/api/records/ym7fc-x0r93/files/TI_SI.ascii/content"}}, "d_m.ascii": {"id": "4b7b4075-5661-4881-800d-76c0f4a07