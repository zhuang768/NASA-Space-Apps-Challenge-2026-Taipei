{"identifier": "Carey-E", "scheme": "clpid"}]}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Choukroun, Mathieu", "given_name": "Mathieu", "family_name": "Choukroun", "identifiers": [{"identifier": "Choukroun-M", "scheme": "clpid"}]}, "affiliations": [{"id": "027k65916", "name": "Jet Propulsion Lab", "identifiers": [{"identifier": "027k65916", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Hudson, Troy", "given_name": "Troy", "family_name": "Hudson", "identifiers": [{"identifier": "Hudson-T", "scheme": "clpid"}]}, "affiliations": [{"id": "027k65916", "name": "Jet Propulsion Lab", "identifiers": [{"identifier": "027k65916", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Schorghofer, Norbert", "given_name": "Norbert", "family_name": "Schorghofer", "identifiers": [{"identifier": "Schorghofer-N", "scheme": "clpid"}]}, "affiliations": [{"id": "01wspgy28", "name": "University of Hawaii at Manoa", "identifiers": [{"identifier": "01wspgy28", "scheme": "ror"}]}]}, {"person_or_org": {"type": "personal", "name": "Xu, Steven", "given_name": "Steven", "family_name": "Xu", "identifiers": [{"identifier": "Xu-Steven", "scheme": "clpid"}]}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}, {"id": "03taz7m60", "name": "University of Southern California", "identifiers": [{"identifier": "03taz7m60", "scheme": "ror"}]}]}], "title": "Measurements of thermal properties of icy Mars regolith analogs", "publisher": "American Geophysical Union", "publication_date": "2012-03-07", "subjects": [{"subject": "Mars"}, {"subject": "ice"}, {"subject": "permafrost"}, {"subject": "regolith"}, {"subject": "thermal conductivity"}, {"subject": "thermal properties"}], "dates": [{"date": "2012-04-11", "type": {"id": "created", "title": {"de": "Erstellt", "en": "Created"}}, "description": "Created from EPrint's datestamp field"}, {"date": "2021-11-09", "type": {"id": "updated", "title": {"de": "Aktualisiert", "en": "Updated"}}, "description": "Created from EPrint's last_modified field"}], "identifiers": [{"identifier": "30059", "scheme": "eprintid"}, {"identifier": "CaltechAUTHORS:20120411-103559909", "scheme": "resolverid"}], "version": "Published", "rights": [{"title": {"en": "Other"}, "description": {"en": "No commercial reproduction, distribution, display or performance rights in this work are provided."}}], "description": "In a series of laboratory experiments, we measure thermal diffusivity, thermal conductivity, and heat capacity of icy regolith created by vapor deposition of water below its triple point and in a low pressure atmosphere. We find that an ice-regolith mixture prepared in this manner, which may be common on Mars, and potentially also present on the Moon, Mercury, comets and other bodies, has a thermal conductivity that increases approximately linearly with ice content. This trend differs substantially from thermal property models based of preferential formation of ice at grain contacts previously applied to both terrestrial and non-terrestrial subsurface ice. We describe the observed microphysical structure of ice responsible for these thermal properties, which displaces interstitial gases, traps bubbles, exhibits anisotropic growth, and bridges non-neighboring grains. We also consider the applicability of these measurements to subsurface ice on Mars and other solar system bodies.", "additional_descriptions": [{"description": "\u00a9 2012 by the American Geophysical Union.\n\nReceived 18 August 2011; revised 20 December 2011; accepted 20 December 2011; published 7 March 2012.\nWe thank Julie Castillo, Doug Cobos,\nMichael Hecht, Gerard Kluitenberg, Kenneth Libbrecht, Michael Mellon,\nDavid Paige, Marsha Presley, Al Slavin, and Steven Wood for their useful\ndiscussions and Axel Schmidt for aid in measuring grain surface roughness,\nKaren Wacker for the construction of and insightful discussion in designing\nour thermal properties probe, and Hermann Engelhardt, Liz Carey, and\nKenny Oslund for years of guidance and dedication in the lab. This work\nwas supported by the Mars Fundamental Research Program. Part of this\nwork has been conducted at the Jet Propulsion Laboratory, California Institute\nof Technology, under contract to NASA. Government sponsorship\nacknowledged.", "type": {"id": "additional", "title": {"de": "Sonstige", "en": "Additional Information"}}}, {"description": "<p>Published - <a href=\"/records/bf4f9-kz243/files/Siegler2012p17729J_Geophys_Res-Planet.pdf?download=1\">Siegler2012p17729J_Geophys_Res-Planet.pdf</a></p>", "type": {"id": "attached-files", "title": {"de": "Sonstige", "en": "Attached Files"}}}], "funding": [{"funder": {"name": "NASA"}}]}, "custom_fields": {"journal:journal": {"title": "Journal of Geophysical Research E", "issue": "E3", "volume": "117", "pages": "Art. No. E03001", "issn": "0148-0227"}}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 1, "total_bytes": 1271499, "entries": {"Siegler2012p17729J_Geophys_Res-Planet.pdf": {"id": "dd3ce581-fa0a-4da4-aecc-c5b32f77e660", "checksum": "md5:5308781324d45fc40b1af060e9bf790b", "ext": "pdf", "size": 1271499, "mimetype": "application/pdf", "storage_class": "L", "key": "Siegler2012p17729J_Geophys_Res-Planet.pdf", "metadata": null, "access": {"hidden": false}, "links": {"self": "https://authors.library.caltech.edu/api/records/bf4f9-kz243/files/Siegler2012p17729J_Geophys_Res-Planet.pdf", "content": "https://authors.library.caltech.edu/api/records/bf4f9-kz243/files/Siegler2012p17729J_Geophys_Res-Planet.pdf/content", "iiif_canvas": "https://authors.library.caltech.edu/api/iiif/record:bf4f9-kz243/canvas/Siegler2012p17729J_Geophys_Res-Pl