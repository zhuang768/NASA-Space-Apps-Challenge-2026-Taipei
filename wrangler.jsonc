{
  // Cloudflare Worker (static assets) for the TerraMatch dashboard.
  // Used by `npx wrangler deploy` and by Workers Builds when the repo is connected in Cloudflare.
  // The GitHub Actions Pages deploy ignores this file (no pages_build_output_dir).
  "$schema": "./web/node_modules/wrangler/config-schema.json",
  "name": "nasa-space-apps-challenge-2026-taipei",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "cd web && npm ci && npm run build"
  },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  }
}
